[Unit]
Description=Power Failure Detection Daemon
# Need network up, Docker up (NATS runs as a container), and storage so
# the JetStream named volume on the boot SSD is reachable. Recovery
# notification goes via NATS → WhatsApp server's in-process consumer;
# the daemon itself only needs NATS to be reachable.
After=network-online.target docker.service wait-for-storage.service
Wants=network-online.target docker.service wait-for-storage.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/power-daemon
# Block until NATS' client port responds. Polls every 2s for up to ~2 min.
# We exit 0 regardless — losing one alert is preferable to refusing to
# start the watchdog. If NATS is genuinely down the daemon's publish
# will fail-with-log and the shutdown sequence proceeds anyway.
ExecStartPre=/bin/bash -c 'echo "Waiting for NATS (port 4222)..."; \
  for i in $(seq 1 60); do \
    (echo > /dev/tcp/localhost/4222) 2>/dev/null \
    && echo "NATS reachable after $((i*2))s" && exit 0; \
    sleep 2; \
  done; \
  echo "NATS not reachable in 120s, starting daemon anyway"; exit 0'
ExecStart=/opt/power-daemon/.venv/bin/python /opt/power-daemon/power_daemon.py
Restart=always
RestartSec=10
User=dinesh
StateDirectory=power-daemon
# Default systemd start timeout is 90s; we wait up to 120s for NATS.
TimeoutStartSec=200

[Install]
WantedBy=multi-user.target
