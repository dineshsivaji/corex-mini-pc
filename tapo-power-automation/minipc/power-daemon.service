[Unit]
Description=Power Failure Detection Daemon
# Wait for the network, Docker, and storage so the recovery WhatsApp
# notification (which goes via HA → WhatsApp API, both running in
# Docker on this host) actually has a working endpoint by the time
# the daemon fires it.
After=network-online.target docker.service wait-for-storage.service
Wants=network-online.target docker.service wait-for-storage.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/power-daemon
# Block until HA's port (8123) responds. Polls every 5s for up to ~5 min.
# `exit 0` at the end means we proceed even if HA never comes up — power
# monitoring is more important than the recovery notification.
ExecStartPre=/bin/bash -c 'for i in $(seq 1 60); do (echo > /dev/tcp/localhost/8123) 2>/dev/null && echo "HA reachable after $((i*5))s" && exit 0; sleep 5; done; echo "HA never reachable in 300s, starting daemon anyway"; exit 0'
ExecStart=/opt/power-daemon/.venv/bin/python /opt/power-daemon/power_daemon.py
Restart=always
RestartSec=10
User=dinesh
StateDirectory=power-daemon
# Default systemd start timeout is 90s; we need 5 min for the HA wait.
TimeoutStartSec=400

[Install]
WantedBy=multi-user.target
