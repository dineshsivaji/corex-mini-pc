[Unit]
Description=Power Failure Detection Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/power-daemon
ExecStart=/usr/bin/python3 /opt/power-daemon/power_daemon.py
Restart=always
RestartSec=10
User=hgd469

[Install]
WantedBy=multi-user.target
