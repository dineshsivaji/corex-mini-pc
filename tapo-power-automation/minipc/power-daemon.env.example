# Mini PC power-daemon configuration.
# Copy to /etc/default/power-daemon (root:root, mode 0600) and fill in real values.
# All keys are optional — defaults in power_daemon.py apply if unset.

# Network targets
POWER_DAEMON_ZEB_SP110_IP=192.168.1.110
POWER_DAEMON_GATEWAY_IP=192.168.1.1
POWER_DAEMON_TAPO_IP=192.168.1.111

# Tapo P110 credentials (TP-Link cloud account)
POWER_DAEMON_TAPO_EMAIL=your_tapo_email@example.com
POWER_DAEMON_TAPO_PASSWORD=your_tapo_password

# HA webhook URLs (local — HA runs on this same host)
POWER_DAEMON_HA_WEBHOOK_POWER_CUT=http://localhost:8123/api/webhook/power_cut_imminent
POWER_DAEMON_HA_WEBHOOK_TAPO_FAILED=http://localhost:8123/api/webhook/tapo_command_failed

# Storage
POWER_DAEMON_HDD_DEVICE=/dev/sda
POWER_DAEMON_STORAGE_MOUNT=/mnt/storage
