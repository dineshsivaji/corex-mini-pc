# Mini PC power-daemon configuration.
# Copy to /etc/default/power-daemon (root:root, mode 0600) and fill in real values.
# All keys are optional — defaults in power_daemon.py apply if unset.

# Network targets
POWER_DAEMON_ZEB_SP110_IP=192.168.1.110
POWER_DAEMON_GATEWAY_IP=192.168.1.1
POWER_DAEMON_TAPO_IP=192.168.1.111

# Tapo P110 credentials (TP-Link cloud account)
POWER_DAEMON_TAPO_EMAIL=your_tapo_email@example.com
POWER_DAEMON_TAPO_PASSWORD=your_tapo_password

# NATS JetStream — daemon publishes notifications here; the WhatsApp
# server's in-process NATS consumer forwards them to Baileys.
POWER_DAEMON_NATS_URL=nats://127.0.0.1:4222
POWER_DAEMON_NATS_SUBJECT=notify.whatsapp

# WhatsApp recipient — phone number with country code (no '+') OR a JID
# OR a group ID. The WhatsApp server's consumer forwards this verbatim
# as the `to` argument to sendMessage().
POWER_DAEMON_WHATSAPP_TO=919999999999

# Bundled quote lines file (daemon owns rotation now; previously HA did)
POWER_DAEMON_QUOTE_LINES_PATH=/opt/power-daemon/quote_lines.yaml

# Storage
POWER_DAEMON_HDD_DEVICE=/dev/sda
POWER_DAEMON_STORAGE_MOUNT=/mnt/storage

# Tunables (uncomment to override defaults)
# POWER_DAEMON_PING_INTERVAL_SEC=60
# POWER_DAEMON_FAILURE_THRESHOLD_SEC=300
# POWER_DAEMON_TAPO_COUNTDOWN_SEC=60
# POWER_DAEMON_PING_TIMEOUT_SEC=5
# Bump to 10 if Zeb / smart plugs are flaky:
# POWER_DAEMON_PING_PACKET_COUNT=5
# POWER_DAEMON_NATS_PUBLISH_TIMEOUT_SEC=5
